# orgbrain reads this file through docker compose. Copy it to .env and change what you need.

# Model runtime. By default the api runs Codex CLI on your ChatGPT plan. Log in once inside the stack with
#   docker compose run --rm api codex login --device-auth
# The login lives in the `codex` volume, apart from any Codex you use on this machine. The Settings page in the web
# app can switch runtimes later.

# Or any OpenAI-compatible API instead of Codex:
# ORGBRAIN_API_ARGS=--runtime api --base-url https://openrouter.ai/api/v1 --model openai/gpt-5-mini
# OPENAI_API_KEY=

# Slack bot (docker compose --profile slack up -d); see docs/slack.md
# ORGBRAIN_SLACK_BOT_TOKEN=
# ORGBRAIN_SLACK_APP_TOKEN=
# ORGBRAIN_SLACK_USERS={"U0123456789": "monica.patel"}

# Host ports, all bound to 127.0.0.1. Change them to run a second copy next to this one.
# ORGBRAIN_WEB_PORT=3000
# ORGBRAIN_API_PORT=8000
# ORGBRAIN_QDRANT_PORT=6333
# ORGBRAIN_POSTGRES_PORT=5432
# ORGBRAIN_REDIS_PORT=6379
